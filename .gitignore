# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Model checkpoints / weights
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/

# Large datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated outputs
results/figures/*
results/tables/*
results/models/*
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/models/.gitkeep

# Temporary files
*.tmp
*.log

results/line_segmentation_preview/
results/line_segmentation_v2/

# Real-world evaluation: raw photos may contain personal handwriting
evaluation/photos/*
!evaluation/photos/.gitkeep

# Allow the deployment model (about 29 MB) to be committed on purpose
!models/final_model.pt

# Example images exported from OpenHand-Synth test set for demo
app/examples/*
!app/examples/README.md

# Real-world page photographs, hand crops and outputs may contain personal
# handwriting: keep them local (README, template and .gitkeep stay tracked)
evaluation/real_world/*
!evaluation/real_world/README.md
!evaluation/real_world/ground_truth_template.csv
!evaluation/real_world/manual_lines/
evaluation/real_world/manual_lines/*
!evaluation/real_world/manual_lines/.gitkeep
results/segmentation_benchmark/
!app/examples/examples.csv
!app/examples/*.png
